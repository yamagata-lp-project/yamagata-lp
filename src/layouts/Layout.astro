---
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "山形不用品回収サービス｜最短30分・即日対応【エイトステップ】",
	description = "山形県内の不用品お片付けはお任せください。最短30分でお伺い、9,900円〜の明確な料金プランでスピード対応します。",
} = Astro.props;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<!-- iOS Safari auto-detects addresses/phone numbers in plain text and
		     makes them tap-to-open-Maps/dialer; the footer address was getting
		     swept up in this even though it's plain text, not a link. Explicit
		     tel: links elsewhere are unaffected by this meta tag. -->
		<meta name="format-detection" content="telephone=no, address=no" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			id="webfonts"
			rel="preload"
			as="style"
			href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&family=Oswald:wght@400;700&family=Roboto:wght@700&display=swap"
			onload="this.onload=null;this.rel='stylesheet'"
		/>
		<noscript>
			<link
				rel="stylesheet"
				href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&family=Oswald:wght@400;700&family=Roboto:wght@700&display=swap"
			/>
		</noscript>

		<script type="text/javascript" is:inline>
			(function (c, l, a, r, i, t, y) {
				c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
				t = l.createElement(r); t.async = 1; t.src = "https://www.clarity.ms/tag/" + i;
				y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
			})(window, document, "clarity", "script", "yhmctq29h3");
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>
