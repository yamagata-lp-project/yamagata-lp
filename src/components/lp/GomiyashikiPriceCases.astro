---
// 仮テキスト・仮価格: 後ほど実際の内容に差し替え
const groups = [
	{ label: "1R・1K", budget: "〇〇,000円〜", items: [["【仮】床の一部にゴミがある", "〇〇,000円"], ["【仮】床がほぼ見えない", "〇〇,000円"]] },
	{ label: "1LDK・2DK", budget: "〇〇,000円〜", items: [["【仮】1部屋のみ", "〇〇,000円"], ["【仮】全部屋", "〇〇,000円"]] },
	{ label: "3LDK〜・一軒家", budget: "〇〇〇,000円〜", items: [["【仮】2〜3部屋", "〇〇〇,000円"], ["【仮】家全体", "〇〇〇,000円"]] },
];
---

<section id="g-price-cases" class="g-pc">
	<div class="l-container">
		<div class="section-heading">
			<p class="section-heading__kicker">間取り・予算別</p>
			<p class="section-heading__ja">料金事例</p>
			<p class="section-heading__lead">【仮】実際の作業事例をもとにした料金の目安です。</p>
		</div>
		<div class="g-pc__grid">
			{groups.map((g) => (
				<article class="g-pc__card">
					<h3 class="g-pc__label">{g.label}</h3>
					<p class="g-pc__budget">目安 <strong>{g.budget}</strong></p>
					<ul class="g-pc__items">
						{g.items.map(([name, price]) => (
							<li><span>{name}</span><span class="g-pc__price">{price}</span></li>
						))}
					</ul>
				</article>
			))}
		</div>
		<p class="g-pc__note">※【仮】金額はあくまで目安です。現地確認後に確定金額をご案内します。</p>
	</div>
</section>

<style>
	.g-pc { padding-block: 56px; }
	.g-pc__grid { display: grid; grid-template-columns: 1fr; gap: 16px; margin-top: 32px; }
	.g-pc__card { border: 2px solid var(--color-primary); border-radius: 12px; overflow: hidden; background: #fff; }
	.g-pc__label { background: var(--color-primary); color: #fff; font-weight: 700; font-size: 18px; padding: 10px 16px; }
	.g-pc__budget { padding: 12px 16px 0; font-size: 14px; }
	.g-pc__budget strong { color: var(--color-accent-red); font-size: 22px; }
	.g-pc__items { list-style: none; padding: 8px 16px 16px; margin: 0; }
	.g-pc__items li { display: flex; justify-content: space-between; gap: 12px; padding: 10px 0; border-bottom: 1px dashed var(--color-border-gray); font-size: 14px; }
	.g-pc__price { font-weight: 700; white-space: nowrap; }
	.g-pc__note { margin-top: 16px; font-size: 12px; color: var(--color-text-sub); }
	@media (min-width: 768px) { .g-pc__grid { grid-template-columns: repeat(3, 1fr); } }
</style>
