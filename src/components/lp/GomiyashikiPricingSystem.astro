---
// 仮テキスト
const steps = [
	{ title: "【仮】作業人数 × 作業時間", text: "【仮テキスト】スタッフの人数と作業時間をもとに基本料金を算出します。" },
	{ title: "【仮】トラック台数・処分量", text: "【仮テキスト】搬出する物量に応じて、トラックの種類と台数が決まります。" },
	{ title: "【仮】オプション費用", text: "【仮テキスト】消臭・清掃・家電リサイクルなど、必要な作業のみ加算されます。" },
];
---

<section id="g-system" class="g-sys">
	<div class="l-container">
		<div class="section-heading">
			<p class="section-heading__kicker">明確・分かりやすい</p>
			<p class="section-heading__ja">料金体系の仕組み</p>
			<p class="section-heading__lead">【仮】料金がどう決まるのかを、事前にきちんとご説明します。</p>
		</div>
		<ol class="g-sys__list">
			{steps.map((s, i) => (
				<li class="g-sys__item">
					<span class="g-sys__num">{i + 1}</span>
					<div>
						<p class="g-sys__title">{s.title}</p>
						<p class="g-sys__text">{s.text}</p>
					</div>
				</li>
			))}
		</ol>
		<p class="g-sys__formula">基本料金 ＋ 処分費 ＋ オプション ＝ <strong>確定金額【仮】</strong></p>
	</div>
</section>

<style>
	.g-sys { padding-block: 56px; background: var(--color-bg-pale-1); }
	.g-sys__list { list-style: none; padding: 0; margin: 32px 0 0; display: grid; gap: 14px; }
	.g-sys__item { display: flex; gap: 14px; align-items: flex-start; background: #fff; border-radius: 12px; padding: 18px; }
	.g-sys__num { flex: none; width: 36px; height: 36px; border-radius: 50%; background: var(--color-primary); color: #fff; font-weight: 900; display: grid; place-items: center; }
	.g-sys__title { font-weight: 700; font-size: 16px; }
	.g-sys__text { font-size: 14px; line-height: 1.7; margin-top: 4px; }
	.g-sys__formula { margin-top: 24px; text-align: center; font-weight: 700; font-size: 15px; line-height: 1.6; }
	.g-sys__formula strong { color: var(--color-accent-red); }
	@media (min-width: 768px) { .g-sys__list { grid-template-columns: repeat(3, 1fr); } }
</style>
