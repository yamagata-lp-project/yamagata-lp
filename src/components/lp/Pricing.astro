---
import keitora from "../../assets/lp/keitora.webp";
import truck15t from "../../assets/lp/1.5t.webp";
import truck2t from "../../assets/lp/2tver2.webp";
import { Image } from "astro:assets";

const plans = [
	{
		img: truck15t,
		name: "1.5tトラックプラン",
		guide: "二人暮らし・2K～2LDK",
		truckClass: "pricing__truck",
		price: "40,000",
		width: 560,
		height: 420,
	},
	{
		img: truck2t,
		name: "2tトラックプラン",
		guide: "戸建・マンション丸ごと",
		truckClass: "pricing__truck pricing__truck--2t",
		price: "75,000",
		width: 560,
		height: 420,
	},
];

// 1 wide light-truck card on top (spans both columns), then 1.5t + 2t side by side.
// The light-truck plan is three size tiers of the same truck, so it is a single
// card with a static (non-interactive) price guide instead of three cards.
const keitoraGuide = "一人暮らし・1R～1LDK";

// shown once, at the bottom of the section, as two separate lines
const cardNotes = [
	"法律で定められたリサイクル家電や一部特殊品を回収する場合や、オプション作業などが必要な場合は別途費用となります。",
	"現地確認後、追加料金を頂くことは一切ございません。",
];

const keitoraSizes = [
	{ label: "お手軽サイズ", price: "9,000", note: "荷台の半分で収まる場合" },
	{ label: "通常サイズ", price: "15,000", note: "屋根の高さまでに収まる場合" },
	{ label: "満載サイズ", price: "19,000", note: "屋根を超える高さまで積む場合" },
];
---

<section id="pricing" class="pricing">
	<div class="l-container">
		<div class="section-heading">
			<p class="section-heading__kicker">明確・分かりやすい</p>
			<p class="section-heading__ja"><span class="section-heading__ja-accent">3つ</span>の料金プラン</p>
			<p class="section-heading__lead">物量を確認したうえで、お荷物が収まる最適なトラックプランをご案内いたします。</p>
		</div>

		<div class="pricing__slider">
			<ul class="pricing__list">
				<li class="pricing__item pricing__item--keitora">
					<div class="pricing__head">
						<p class="pricing__name">軽トラプラン</p>
					</div>
					<p class="pricing__guide-line"><span class="pricing__guide-pill">容量目安</span><span class="pricing__guide-text">{keitoraGuide}</span></p>
					<Image src={keitora} alt="軽トラック" width={800} height={600} class="pricing__keitora-img" />
					<div class="pricing__sizes">
						{
							keitoraSizes.map((size) => (
								<div class="pricing__size">
									<p class="pricing__size-label">{size.label}</p>
									<p class="pricing__size-price">
										<span class="pricing__size-num">{size.price}</span>
										<span class="pricing__size-unit">円</span>
									</p>
									<p class="pricing__size-note">{size.note}</p>
								</div>
							))
						}
					</div>
				</li>
				{
					plans.map((plan) => (
						<li class="pricing__item">
							<div class="pricing__head">
								<p class="pricing__name">{plan.name}</p>
							</div>
							<p class="pricing__guide-line"><span class="pricing__guide-pill">容量目安</span><span class="pricing__guide-text">{plan.guide}</span></p>
							<Image src={plan.img} alt={plan.name} width={plan.width} height={plan.height} class={plan.truckClass} />
							<p class="pricing__price">
								{plan.price}<span class="pricing__price-unit">円</span>
							</p>
						</li>
					))
				}
			</ul>
		</div>

		<p class="pricing__note">
			{cardNotes.map((note) => <span class="pricing__note-line">{note}</span>)}
		</p>
	</div>
</section>

<style>
	.pricing {
		background: var(--color-bg-pale-1);
		padding-block: 60px 90px;
		position: relative;
	}

	.pricing__slider {
		max-width: 100%;
		margin-inline: auto;
	}

	.pricing__list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 12px;
		padding: 4px 0 12px;
		margin: 0 auto;
		list-style: none;
	}

	/* the light-truck card spans both columns, so it matches the combined
	   width of the 1.5t + 2t cards below it */
	/* one value for both the card's left/right padding and the gap between the
	   three size boxes, so the boxes are evenly spaced edge to edge. The
	   selector is doubled-up on specificity so it beats the later
	   .pricing__item padding. */
	.pricing__list > .pricing__item--keitora {
		--keitora-gutter: 10px;
		/* type scale mirrored from the 1.5t/2t cards (.pricing__name,
		   .pricing__price(-unit), .pricing__desc) so the three read as one set;
		   the 1.5t/2t rules themselves are untouched */
		--keitora-name-fs: 15px;
		--keitora-price-fs: 22px;
		--keitora-unit-fs: 15px;
		--keitora-desc-fs: 10px;
		--keitora-desc-lh: 1.6;
		grid-column: 1 / -1;
		padding: 12px var(--keitora-gutter) 16px;
	}

	/* plan name on top, small gray capacity guide below. The head's bottom
	   margin takes over the name's old margin so the spacing to what follows
	   (image / capacity box) stays as it was. */
	.pricing__head {
		margin-bottom: 6px;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.pricing__head .pricing__name {
		margin-bottom: 2px;
	}

	/* the capacity-guide box reuses .pricing__capacity; it holds one line of
	   text, so it doesn't need the 2-line min-height the old load-estimate box
	   had. Doubled class so this also wins over the PC media rule below. */
	.pricing__capacity.pricing__capacity--guide {
		width: fit-content;
		min-height: 0;
	}

	/* one-line oval badge: "容量目安" bold, the rest regular, all white on the
	   site's primary blue. nowrap keeps it on a single line; the font-size
	   floor/ceiling is what lets it fit the narrow 2-up mobile cards. */
	.pricing__guide-badge {
		margin: 0 0 12px;
		padding: 4px 8px;
		max-width: 100%;
		background: var(--color-primary);
		border-radius: 9999px;
		color: #fff;
		font-size: clamp(8px, 2.1vw, 14px);
		font-weight: 400;
		line-height: 1.5;
		white-space: nowrap;
	}

	.pricing__guide-badge-label {
		font-weight: 700;
	}

	/* capacity guide, one centered line: a blue oval holding only "容量目安",
	   with the plan's content as plain dark text beside it (no background or
	   border). nowrap + clamp() sizes keep it on one line in the narrow
	   2-up mobile cards. */
	.pricing__guide-line {
		/* same size as the light-truck card's description text
		   (.pricing__size-note, --keitora-desc-fs); the line's own font-size
		   below only drives the 0.5em gap between the oval and the content */
		--guide-fs: 10px;
		margin: 0 0 12px;
		max-width: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5em;
		font-size: clamp(8px, 2.2vw, 14px);
		line-height: 1.5;
		white-space: nowrap;
	}

	.pricing__guide-pill {
		padding: 3px 6px;
		background: var(--color-primary);
		border-radius: 9999px;
		color: #fff;
		font-size: var(--guide-fs);
		font-weight: 700;
		line-height: 1.5;
	}

	.pricing__guide-text {
		color: var(--color-text);
		font-size: var(--guide-fs);
		font-weight: 400;
	}

	/* the 2t artwork fills its canvas edge to edge while the 1.5t one has some
	   margin, so at the same box size the 2t truck looks oversized; scale it
	   down from the bottom so the wheels stay on the shared baseline */
	.pricing__truck--2t {
		transform: scale(0.93);
		transform-origin: bottom center;
	}

	.pricing__guide {
		margin: 0;
		font-size: 9px;
		line-height: 1.5;
		color: var(--color-text-sub);
	}

	.pricing__guide span {
		display: inline-block;
	}

	.pricing__card-notes {
		margin-top: 12px;
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.pricing__card-note {
		margin: 0;
		font-size: 10px;
		line-height: 1.6;
		color: #666;
	}

	.pricing__keitora-img {
		width: 100%;
		max-width: 216px;
		height: auto;
		margin-bottom: 10px;
	}

	/* static price guide, not a choice: no button styling, hover or pointer */
	.pricing__sizes {
		width: 100%;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--keitora-gutter);
	}

	.pricing__size {
		background: #e5e9ee;
		border-radius: 8px;
		padding: 10px 4px 12px;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	.pricing__size-label {
		margin: 0 0 6px;
		font-family: var(--font-heading);
		font-weight: 900;
		font-size: var(--keitora-name-fs);
		line-height: 1.3;
		color: var(--color-text);
	}

	.pricing__size-price {
		margin: 0 0 6px;
		font-family: var(--font-number);
		font-weight: 700;
		line-height: 1.2;
		color: var(--color-accent-red);
		white-space: nowrap;
	}

	.pricing__size-num {
		font-size: var(--keitora-price-fs);
		/* yellow highlighter-style underline across the lower part of the digits */
		background: linear-gradient(transparent 62%, #ffe14d 62%);
		padding-inline: 2px;
	}

	.pricing__size-unit {
		font-size: var(--keitora-unit-fs);
	}

	.pricing__size-note {
		margin: 0;
		font-size: var(--keitora-desc-fs);
		line-height: var(--keitora-desc-lh);
		color: var(--color-text);
		text-wrap: balance;
	}

	.pricing__item {
		min-width: 0;
		background: #fff;
		border: 1px solid #d9d9d9;
		border-radius: 4px;
		padding: 16px 4px;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.pricing__item:hover,
	.pricing__item:active,
	.pricing__item:focus-within {
		transform: translateY(-6px);
		box-shadow: 0 12px 20px rgba(3, 129, 220, 0.2);
	}

	.pricing__badge {
		min-height: 1.4em;
		margin: 0 0 4px;
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 11px;
		line-height: 1.4;
		color: var(--color-accent-red);
	}

	.pricing__name {
		font-family: var(--font-heading);
		font-weight: 900;
		font-size: 15px;
		color: var(--color-text);
		margin-bottom: 14px;
	}

	.pricing__capacity {
		position: relative;
		width: fit-content;
		max-width: 100%;
		/* tall enough to fit 2 lines of .pricing__desc (11px * 1.6 * 2 + the
		   box's own padding) so 1-line plans get the same box height as
		   2-line plans, keeping the truck image and price aligned below */
		min-height: 56px;
		background: var(--color-bg-pale-2);
		border: 1px solid var(--color-border-gray);
		border-radius: 4px;
		padding: 12px 8px 6px;
		margin-bottom: 12px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.pricing__capacity-label {
		position: absolute;
		top: -7px;
		left: -6px;
		margin: 0;
		background: var(--color-primary);
		border-radius: 999px;
		padding: 3px 8px;
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 9px;
		line-height: 1;
		letter-spacing: 0.02em;
		color: #fff;
		white-space: nowrap;
	}

	.pricing__desc {
		font-size: 10px;
		line-height: 1.6;
		color: var(--color-text);
		margin: 0;
	}

	/* the class sits directly on the <img> the Image component renders, so
	   this must target the class itself, not a `:global(img)` descendant */
	/* the 5 source illustrations don't share one aspect ratio (the 1.5t/2t
	   trucks are drawn on a shorter canvas), so a plain height:auto leaves
	   them sitting higher than the others. Fixing the box height and
	   bottom-anchoring the artwork keeps every truck's wheels on the same
	   line regardless of its native proportions. */
	.pricing__truck {
		width: 100%;
		max-width: 162px;
		height: 122px;
		object-fit: contain;
		object-position: bottom center;
		margin-bottom: 12px;
	}

	.pricing__price {
		font-family: var(--font-number);
		font-weight: 700;
		font-size: 22px;
		color: var(--color-accent-red);
		line-height: 1;
	}

	.pricing__price-unit {
		font-size: 15px;
	}

	.pricing__note-line {
		display: block;
		text-wrap: balance;
	}

	.pricing__note {
		text-align: center;
		font-family: var(--font-en);
		font-size: 14px;
		color: var(--color-text);
	}

	/* mobile 2-up cards (1.5t / 2t) are too narrow to hold the oval and its
	   content on one line at the description's font size, so the content drops
	   below the oval. Always wrapping (not width-dependent) keeps the two cards
	   identical in height and alignment. The light-truck card stays on one line. */
	@media (max-width: 767px) {
		.pricing__item:not(.pricing__item--keitora) .pricing__guide-line {
			flex-wrap: wrap;
			row-gap: 4px;
		}

		.pricing__item:not(.pricing__item--keitora) .pricing__guide-text {
			flex-basis: 100%;
			text-align: center;
		}
	}

	/* PC: same 1 + 2 layout, with the 1.5t/2t cards at their original width */
	@media (min-width: 768px) {
		.pricing__slider {
			max-width: none;
		}

		/* keep the 1.5t/2t cards at their previous width: two of them plus the
		   gap = two thirds of the old 3-up row, and the light-truck card spans it */
		.pricing__list {
			max-width: calc((100% - 64px) * 2 / 3 + 32px);
			gap: 32px;
			padding: 0;
		}

		.pricing__item {
			padding: 24px 20px;
		}

		.pricing__list > .pricing__item--keitora {
			--keitora-gutter: 24px;
			--keitora-name-fs: 24px;
			--keitora-price-fs: 40px;
			--keitora-unit-fs: 28px;
			--keitora-desc-fs: 15px;
			--keitora-desc-lh: 1.7;
			padding: 20px var(--keitora-gutter) 26px;
		}

		.pricing__head {
			margin-bottom: 8px;
		}

		.pricing__guide {
			font-size: 14px;
		}

		.pricing__guide-line {
			--guide-fs: 15px;
			margin-bottom: 16px;
			font-size: clamp(9px, 1.1vw, 14px);
		}

		.pricing__guide-pill {
			padding: 5px clamp(10px, 1.1vw, 14px);
		}

		.pricing__guide-badge {
			margin-bottom: 16px;
			padding: 6px clamp(12px, 1.4vw, 18px);
			font-size: clamp(9px, 1.1vw, 14px);
		}

		.pricing__card-notes {
			margin-top: 16px;
		}

		.pricing__card-note {
			font-size: 12px;
		}

		.pricing__keitora-img {
			max-width: 360px;
			margin-bottom: 14px;
		}

		.pricing__size {
			padding: 18px 4px 20px;
		}

		.pricing__badge {
			font-size: 14px;
		}

		.pricing__name {
			font-size: 24px;
			margin-bottom: 18px;
		}

		.pricing__capacity {
			/* tall enough to fit 2 lines of .pricing__desc (15px * 1.7 * 2 +
			   the box's own padding) so all cards align below regardless of
			   1-line vs 2-line description text */
			width: 80%;
			min-height: 78px;
			padding: 16px 10px 8px;
			margin-bottom: 16px;
		}

		.pricing__capacity-label {
			top: -9px;
			left: -7px;
			padding: 4px 12px;
			font-size: 11px;
		}

		.pricing__desc {
			font-size: 15px;
			line-height: 1.7;
			margin: 0;
		}

		.pricing__truck {
			max-width: 336px;
			height: 252px;
			margin-bottom: 16px;
		}

		.pricing__price {
			font-size: 40px;
		}

		.pricing__price-unit {
			font-size: 28px;
		}

		.pricing__note {
			font-size: 16px;
		}
	}
</style>
