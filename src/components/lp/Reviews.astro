---
import face1 from "../../assets/lp/face1.webp";
import face2 from "../../assets/lp/face2.webp";
import face3 from "../../assets/lp/face3.webp";
import face4 from "../../assets/lp/face4.webp";
import face5 from "../../assets/lp/face5.webp";
import { Image } from "astro:assets";

const faces = [face1, face2, face3, face4, face5];

const rating = {
	score: "4.9",
	count: 390,
};

const reviews = [
	{
		rating: 5,
		title: "安心して即日依頼できました",
		body: "朝一番に電話すると丁寧な対応で、すぐに折り返しの連絡がありました。午後一番には回収に来てもらえ、担当の前田さんは爽やかで丁寧な仕事ぶり。最後まで笑顔で対応してくださり、本当に助かりました。",
		name: "S.K様",
		area: "山形市白山",
	},
	{
		rating: 5,
		title: "料金通りで安心して引越せます！",
		body: "他社に断られた和ダンスも快く引き受けてくれました。急な依頼にも関わらず料金は当初のウェブ表示通りで、3名のスタッフが声を掛け合いながら手際よく大量の荷物を運び出してくれ、安心してお任せできました。",
		name: "M.T様",
		area: "山形市香澄町",
	},
	{
		rating: 5,
		title: "家の中がスッキリしました！",
		body: "口コミを見て軽トラ通常プランを依頼しました。LINE見積もりが分かりやすく、森様・村上様の作業はとてもスムーズ。マットレスや大型のダイニングテーブル、子供のおもちゃなども積んでいただき、家の中がスッキリしました。",
		name: "A.N様",
		area: "山形市花楯",
	},
	{
		rating: 5,
		title: "実家を丁寧・スムーズに片付けてくれました",
		body: "実家の片付けで新野さんにお世話になりました。事前連絡から作業完了まで丁寧でスムーズ。粗大ゴミの搬入後、トラックに空きがないか確認し、スペースいっぱいまで不用品を積んでくださりとても助かりました。",
		name: "H.O様",
		area: "山形市東青田",
	},
	{
		rating: 5,
		title: "子育て中でもLINE見積もりで安心でした",
		body: "引っ越しで出た不用品をLINEで丁寧にご提案いただき依頼しました。当日追加で出たゴミも急遽対応いただき、子育て中で返信の早いLINEのやり取りはとても安心。15分ほどでテキパキ運び出してくださり、また頼みたいです。",
		name: "Y.I様",
		area: "山形市千歳",
	},
];

// Render 3 copies back-to-back so the carousel can loop infinitely: the
// middle copy is what's shown initially, and the JS below silently jumps
// between copies at the edges to fake an endless loop.
const loopedReviews = [...reviews, ...reviews, ...reviews];
const initialIndex = reviews.length; // first card of the middle copy
---

<section id="reviews" class="reviews">
	<div class="l-container">
		<div class="section-heading">
			<p class="section-heading__kicker">＼リアルな声をご紹介／</p>
			<p class="section-heading__ja">お客様の声</p>
			<p class="section-heading__lead">弊社では、サービス向上を目的として担当者の名前入りのご感想を頂いております。ぜひご利用者様の生の声をご覧ください。</p>
		</div>

		<div class="reviews__rating">
			<span class="reviews__rating-source">Google</span>
			<span class="reviews__rating-score">{rating.score}</span>
			<span class="reviews__rating-stars" aria-hidden="true">
				{Array.from({ length: 5 }).map(() => <span class="reviews__star reviews__star--full">★</span>)}
			</span>
			<span class="reviews__rating-count">（{rating.count}件のクチコミ）</span>
		</div>

		<div class="reviews__slider" data-reviews-slider data-review-count={reviews.length} data-initial-index={initialIndex}>
			<ul class="reviews__list" data-reviews-track>
				{
					loopedReviews.map((review, reviewIndex) => (
						<li class="reviews__card">
							<div class="reviews__card-head">
								<span class="reviews__avatar">
									<Image src={faces[reviewIndex % faces.length]} alt="" width={96} height={96} />
								</span>
								<div class="reviews__card-person">
									<p class="reviews__card-name">{review.name}（{review.area}）</p>
									<div class="reviews__card-stars" aria-label={`評価${review.rating}`}>
										{Array.from({ length: 5 }).map((_, i) => (
											<span class={`reviews__star ${i < review.rating ? "reviews__star--full" : "reviews__star--empty"}`}>★</span>
										))}
									</div>
								</div>
							</div>
							<p class="reviews__card-title">{review.title}</p>
							<p class="reviews__card-body">{review.body}</p>
						</li>
					))
				}
			</ul>

			<div class="reviews__nav">
				<button type="button" class="reviews__nav-btn" data-reviews-prev aria-label="前の口コミ">
					‹
				</button>
				<button type="button" class="reviews__nav-btn" data-reviews-next aria-label="次の口コミ">
					›
				</button>
			</div>
		</div>
	</div>
</section>

<script>
	document.querySelectorAll<HTMLElement>("[data-reviews-slider]").forEach((slider) => {
		const track = slider.querySelector<HTMLElement>("[data-reviews-track]");
		if (!track) return;

		const count = Number(slider.dataset.reviewCount || "0");
		const cards = Array.from(track.querySelectorAll<HTMLElement>(".reviews__card"));
		if (!count || cards.length !== count * 3) return;

		let currentIndex = Number(slider.dataset.initialIndex || count);

		// align the card's left edge with the track's left edge (matches the
		// existing scroll-snap-align: start look), measured via
		// getBoundingClientRect since offsetLeft is relative to the nearest
		// positioned ancestor, not the scroll track
		const alignOn = (index: number, smooth: boolean) => {
			const card = cards[index];
			if (!card) return;
			const cardRect = card.getBoundingClientRect();
			const trackRect = track.getBoundingClientRect();
			const target = cardRect.left - trackRect.left + track.scrollLeft;
			track.scrollTo({ left: target, behavior: smooth ? "smooth" : "instant" });
		};

		// keep the index inside the middle copy [count, count*2 - 1]; if a
		// run of clicks pushed it into an outer clone, silently snap back by
		// one full loop (identical content, so it's visually seamless)
		const resyncIfNeeded = () => {
			if (currentIndex >= count * 2) {
				currentIndex -= count;
				alignOn(currentIndex, false);
			} else if (currentIndex < count) {
				currentIndex += count;
				alignOn(currentIndex, false);
			}
		};

		let settleTimer: ReturnType<typeof setTimeout>;
		track.addEventListener("scroll", () => {
			clearTimeout(settleTimer);
			settleTimer = setTimeout(resyncIfNeeded, 150);
		});

		const go = (dir: number) => {
			currentIndex += dir;
			// always retarget an absolute position (rather than a relative
			// scrollBy) so rapid repeated clicks each land exactly one card
			// further instead of compounding on an in-flight animation
			alignOn(currentIndex, true);
		};

		slider.querySelector("[data-reviews-prev]")?.addEventListener("click", () => go(-1));
		slider.querySelector("[data-reviews-next]")?.addEventListener("click", () => go(1));

		// align the initial card without animation, then re-align on resize
		alignOn(currentIndex, false);
		let resizeTimer: ReturnType<typeof setTimeout>;
		window.addEventListener("resize", () => {
			clearTimeout(resizeTimer);
			resizeTimer = setTimeout(() => alignOn(currentIndex, false), 150);
		});
	});
</script>

<style>
	.reviews {
		background: #ffffff;
		padding-block: 60px 70px;
	}

	.reviews__rating {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 8px;
		margin-top: -8px;
		margin-bottom: 10px;
	}

	.reviews__rating-source {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 15px;
		color: #4285f4;
	}

	.reviews__rating-score {
		font-family: var(--font-number);
		font-weight: 700;
		font-size: 26px;
		color: var(--color-text);
		line-height: 1;
	}

	.reviews__rating-stars {
		display: inline-flex;
		gap: 1px;
	}

	.reviews__star {
		font-size: 18px;
		line-height: 1;
	}

	.reviews__star--full {
		color: #f5a623;
	}

	.reviews__star--empty {
		color: #d9d9d9;
	}

	.reviews__rating-count {
		font-family: var(--font-heading);
		font-size: 13px;
		color: var(--color-text-sub);
	}

	.reviews__list {
		display: flex;
		gap: 16px;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		padding-block: 4px 12px;
		padding-inline: 4px;
		-webkit-overflow-scrolling: touch;
		scrollbar-width: none;
	}

	.reviews__list::-webkit-scrollbar {
		display: none;
	}

	.reviews__card {
		flex: 0 0 auto;
		width: 260px;
		scroll-snap-align: start;
		background: #fff;
		border: 1px solid var(--color-border-gray);
		border-radius: 8px;
		padding: 18px 16px;
		box-shadow: 2px 2px 8px rgba(0, 0, 0, 0.06);
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.reviews__card-head {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.reviews__card-person {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.reviews__card-stars {
		display: flex;
		gap: 1px;
	}

	.reviews__card-stars .reviews__star {
		font-size: 15px;
	}

	.reviews__avatar {
		flex-shrink: 0;
		width: 48px;
		height: 48px;
		border-radius: 50%;
		background: #d9d9d9;
		overflow: hidden;
		display: block;
	}

	.reviews__avatar :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.reviews__card-title {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 15px;
		color: var(--color-text);
		line-height: 1.5;
	}

	.reviews__card-body {
		font-size: 13px;
		line-height: 1.7;
		color: #444;
	}

	.reviews__card-name {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 13px;
		color: var(--color-text);
	}

	@media (min-width: 768px) {
		.reviews__card {
			width: 300px;
		}
	}

	.reviews__nav {
		margin-top: 4px;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 20px;
	}

	.reviews__nav-btn {
		width: 44px;
		height: 44px;
		border-radius: 50%;
		border: none;
		background: var(--color-primary);
		color: #fff;
		font-size: 22px;
		line-height: 1;
		cursor: pointer;
		box-shadow: 0 0 8px rgba(0, 0, 0, 0.2);
	}
</style>
