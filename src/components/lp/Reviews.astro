---
import face1 from "../../assets/lp/face1.webp";
import face2 from "../../assets/lp/face2.webp";
import face3 from "../../assets/lp/face3.webp";
import face4 from "../../assets/lp/face4.webp";
import face5 from "../../assets/lp/face5.webp";
import { Image } from "astro:assets";

const faces = [face1, face2, face3, face4, face5];

const rating = {
	score: "4.9",
	count: 390,
};

const reviews = [
	{
		rating: 5,
		title: "安心して即日依頼できました",
		body: "朝一番に電話すると丁寧な対応で、すぐに折り返しの連絡がありました。午後一番には回収に来てもらえ、担当の前田さんは爽やかで丁寧な仕事ぶり。最後まで笑顔で対応してくださり、本当に助かりました。",
		name: "S.K様",
		area: "山形市",
	},
	{
		rating: 5,
		title: "料金通りで安心して引越せます！",
		body: "他社に断られた和ダンスも快く引き受けてくれました。急な依頼にも関わらず料金は当初のウェブ表示通りで、3名のスタッフが声を掛け合いながら手際よく大量の荷物を運び出してくれ、安心してお任せできました。",
		name: "M.T様",
		area: "天童市",
	},
	{
		rating: 5,
		title: "家の中がスッキリしました！",
		body: "口コミを見て軽トラ通常プランを依頼しました。LINE見積もりが分かりやすく、森様・村上様の作業はとてもスムーズ。マットレスや大型のダイニングテーブル、子供のおもちゃなども積んでいただき、家の中がスッキリしました。",
		name: "A.N様",
		area: "上山市",
	},
	{
		rating: 5,
		title: "実家を丁寧・スムーズに片付けてくれました",
		body: "実家の片付けで新野さんにお世話になりました。事前連絡から作業完了まで丁寧でスムーズ。粗大ゴミの搬入後、トラックに空きがないか確認し、スペースいっぱいまで不用品を積んでくださりとても助かりました。",
		name: "H.O様",
		area: "山形市",
	},
	{
		rating: 5,
		title: "子育て中でもLINE見積もりで安心でした",
		body: "引っ越しで出た不用品をLINEで丁寧にご提案いただき依頼しました。当日追加で出たゴミも急遽対応いただき、子育て中で返信の早いLINEのやり取りはとても安心。15分ほどでテキパキ運び出してくださり、また頼みたいです。",
		name: "Y.I様",
		area: "寒河江市",
	},
];
---

<section id="reviews" class="reviews">
	<div class="l-container">
		<div class="section-heading">
			<p class="section-heading__en">Voice</p>
			<p class="section-heading__ja">お客様の声</p>
		</div>

		<div class="reviews__rating">
			<span class="reviews__rating-source">Google</span>
			<span class="reviews__rating-score">{rating.score}</span>
			<span class="reviews__rating-stars" aria-hidden="true">
				{Array.from({ length: 5 }).map(() => <span class="reviews__star reviews__star--full">★</span>)}
			</span>
			<span class="reviews__rating-count">（{rating.count}件のクチコミ）</span>
		</div>

		<div class="reviews__slider" data-reviews-slider>
			<ul class="reviews__list" data-reviews-track>
				{
					reviews.map((review, reviewIndex) => (
						<li class="reviews__card">
							<div class="reviews__card-head">
								<span class="reviews__avatar">
									<Image src={faces[reviewIndex % faces.length]} alt="" width={96} height={96} />
								</span>
								<div class="reviews__card-person">
									<p class="reviews__card-name">{review.name}（{review.area}）</p>
									<div class="reviews__card-stars" aria-label={`評価${review.rating}`}>
										{Array.from({ length: 5 }).map((_, i) => (
											<span class={`reviews__star ${i < review.rating ? "reviews__star--full" : "reviews__star--empty"}`}>★</span>
										))}
									</div>
								</div>
							</div>
							<p class="reviews__card-title">{review.title}</p>
							<p class="reviews__card-body">{review.body}</p>
						</li>
					))
				}
			</ul>

			<div class="reviews__nav">
				<button type="button" class="reviews__nav-btn" data-reviews-prev aria-label="前の口コミ">
					‹
				</button>
				<button type="button" class="reviews__nav-btn" data-reviews-next aria-label="次の口コミ">
					›
				</button>
			</div>
		</div>
	</div>
</section>

<script>
	document.querySelectorAll<HTMLElement>("[data-reviews-slider]").forEach((slider) => {
		const track = slider.querySelector<HTMLElement>("[data-reviews-track]");
		if (!track) return;

		const scrollByOne = (dir: number) => {
			const card = track.querySelector<HTMLElement>(".reviews__card");
			const gap = parseFloat(getComputedStyle(track).columnGap || "0");
			const amount = card ? card.offsetWidth + gap : track.clientWidth;
			track.scrollBy({ left: dir * amount, behavior: "smooth" });
		};

		slider.querySelector("[data-reviews-prev]")?.addEventListener("click", () => scrollByOne(-1));
		slider.querySelector("[data-reviews-next]")?.addEventListener("click", () => scrollByOne(1));
	});
</script>

<style>
	.reviews {
		background: #ffffff;
		padding-block: 60px 70px;
	}

	.reviews__rating {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 8px;
		margin-top: -8px;
		margin-bottom: 10px;
	}

	.reviews__rating-source {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 15px;
		color: #4285f4;
	}

	.reviews__rating-score {
		font-family: var(--font-number);
		font-weight: 700;
		font-size: 26px;
		color: var(--color-text);
		line-height: 1;
	}

	.reviews__rating-stars {
		display: inline-flex;
		gap: 1px;
	}

	.reviews__star {
		font-size: 18px;
		line-height: 1;
	}

	.reviews__star--full {
		color: #f5a623;
	}

	.reviews__star--empty {
		color: #d9d9d9;
	}

	.reviews__rating-count {
		font-family: var(--font-heading);
		font-size: 13px;
		color: var(--color-text-sub);
	}

	.reviews__list {
		display: flex;
		gap: 16px;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		padding-block: 4px 12px;
		padding-inline: 4px;
		-webkit-overflow-scrolling: touch;
		scrollbar-width: none;
	}

	.reviews__list::-webkit-scrollbar {
		display: none;
	}

	.reviews__card {
		flex: 0 0 auto;
		width: 260px;
		scroll-snap-align: start;
		background: #fff;
		border: 1px solid var(--color-border-gray);
		border-radius: 8px;
		padding: 18px 16px;
		box-shadow: 2px 2px 8px rgba(0, 0, 0, 0.06);
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.reviews__card-head {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.reviews__card-person {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.reviews__card-stars {
		display: flex;
		gap: 1px;
	}

	.reviews__card-stars .reviews__star {
		font-size: 15px;
	}

	.reviews__avatar {
		flex-shrink: 0;
		width: 48px;
		height: 48px;
		border-radius: 50%;
		background: #d9d9d9;
		overflow: hidden;
		display: block;
	}

	.reviews__avatar :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.reviews__card-title {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 15px;
		color: var(--color-text);
		line-height: 1.5;
	}

	.reviews__card-body {
		font-size: 13px;
		line-height: 1.7;
		color: #444;
	}

	.reviews__card-name {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 13px;
		color: var(--color-text);
	}

	@media (min-width: 768px) {
		.reviews__card {
			width: 300px;
		}
	}

	.reviews__nav {
		margin-top: 4px;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 20px;
	}

	.reviews__nav-btn {
		width: 44px;
		height: 44px;
		border-radius: 50%;
		border: none;
		background: var(--color-primary);
		color: #fff;
		font-size: 22px;
		line-height: 1;
		cursor: pointer;
		box-shadow: 0 0 8px rgba(0, 0, 0, 0.2);
	}
</style>
