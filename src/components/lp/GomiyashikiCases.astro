---
import { Icon } from "astro-icon/components";

// 仮テキスト: 後ほど実際の内容に差し替え
const cases = [
	{ icon: "lucide:home", title: "【仮】足の踏み場がない", text: "【仮テキスト】床一面にゴミが積み上がり、生活スペースがない状態でもお任せください。" },
	{ icon: "lucide:bug", title: "【仮】害虫・悪臭がひどい", text: "【仮テキスト】消臭・害虫駆除も含めて、状況に合わせて対応します。" },
	{ icon: "lucide:users", title: "【仮】家族・親族の家が心配", text: "【仮テキスト】ご本人に代わって、ご家族からのご依頼も承ります。" },
	{ icon: "lucide:key-round", title: "【仮】退去を迫られている", text: "【仮テキスト】期限が迫っている場合も、最短即日で対応します。" },
	{ icon: "lucide:eye-off", title: "【仮】近所に知られたくない", text: "【仮テキスト】無地の車両でうかがうなど、プライバシーに配慮します。" },
	{ icon: "lucide:wallet", title: "【仮】費用が心配", text: "【仮テキスト】確定金額でのお見積もり。無理な勧誘は一切ありません。" },
];
---

<section id="cases" class="g-cases">
	<div class="l-container">
		<div class="section-heading">
			<p class="section-heading__kicker">こんなお悩みありませんか？</p>
			<p class="section-heading__ja">このようなケースは<br />お任せください</p>
			<p class="section-heading__lead">【仮】どんな状態のお部屋でも、まずはご相談ください。</p>
		</div>
		<ul class="g-cases__list">
			{cases.map((c) => (
				<li class="g-cases__item">
					<Icon name={c.icon} class="g-cases__icon" aria-hidden="true" />
					<div>
						<p class="g-cases__title">{c.title}</p>
						<p class="g-cases__text">{c.text}</p>
					</div>
				</li>
			))}
		</ul>
	</div>
</section>

<style>
	.g-cases { padding-block: 56px; background: var(--color-bg-pale-1); }
	.g-cases__list { display: grid; grid-template-columns: 1fr; gap: 14px; margin-top: 32px; list-style: none; padding: 0; }
	.g-cases__item { display: flex; gap: 14px; align-items: flex-start; background: #fff; border-radius: 12px; padding: 18px; box-shadow: 0 2px 8px rgba(0, 60, 120, 0.08); }
	.g-cases__icon { flex: none; width: 36px; height: 36px; color: var(--color-primary); }
	.g-cases__title { font-weight: 700; font-size: 16px; }
	.g-cases__text { font-size: 14px; line-height: 1.7; margin-top: 4px; }
	@media (min-width: 768px) {
		.g-cases__list { grid-template-columns: repeat(3, 1fr); }
	}
</style>
