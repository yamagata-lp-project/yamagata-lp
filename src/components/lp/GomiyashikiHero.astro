---
import { Image } from "astro:assets";
// 仮画像: 既存のゴミ屋敷写真を一時利用
import heroImg from "../../assets/lp/gomiyashiki-shasin.webp";
---

<section class="g-hero">
	<Image src={heroImg} alt="ゴミ屋敷片付けのイメージ" class="g-hero__img" widths={[480, 800, 1200, 1600]} sizes="100vw" loading="eager" />
	<div class="g-hero__overlay"></div>
	<div class="l-container g-hero__inner">
		<p class="g-hero__tag">山形県全域対応・最短即日</p>
		<h1 class="g-hero__title">ゴミ屋敷の片付け<span class="sr-only">｜山形不用品回収サービス</span></h1>
		<p class="g-hero__lead">【仮】他人に知られず、最短即日で<br />スッキリ片付けます</p>
	</div>
</section>

<style>
	.g-hero {
		position: relative;
		min-height: 420px;
		display: flex;
		align-items: center;
		overflow: hidden;
		color: #fff;
	}
	.g-hero__img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.g-hero__overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(90deg, rgba(0, 40, 80, 0.75), rgba(0, 40, 80, 0.25));
	}
	.g-hero__inner {
		position: relative;
		padding-block: 56px;
	}
	.g-hero__title :global(.sr-only) {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}
	.g-hero__tag {
		display: inline-block;
		background: var(--color-accent-red);
		font-weight: 700;
		font-size: 13px;
		padding: 4px 14px;
		border-radius: 999px;
	}
	.g-hero__title {
		font-family: var(--font-heading);
		font-weight: 900;
		font-size: clamp(34px, 7vw, 64px);
		line-height: 1.25;
		margin-top: 14px;
	}
	.g-hero__lead {
		font-weight: 700;
		font-size: clamp(16px, 2.4vw, 22px);
		line-height: 1.7;
		margin-top: 12px;
	}
</style>
