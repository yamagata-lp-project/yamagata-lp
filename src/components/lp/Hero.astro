---
import { getImage } from "astro:assets";
import pcMain from "../../assets/lp/pc-main.png";
import sumahoMain from "../../assets/lp/sumaho-main.png";

const heroAlt =
	"不用品・粗大ごみ回収でお部屋を丸ごとスッキリ。即日対応可・お見積り無料。今日中に片付けたい方へ。";

// desktop (>=768px) art-directed visual — native 1920x1080, so the widest
// step matches the source 1:1 (no upscaling) while still covering smaller
// desktop viewports without over-serving bytes.
const pcImage = await getImage({
	src: pcMain,
	format: "webp",
	widths: [640, 960, 1280, 1600, 1920],
	priority: true,
});

// mobile (<768px) art-directed visual — native 960x1200, same idea.
const mobileImage = await getImage({
	src: sumahoMain,
	format: "webp",
	widths: [375, 480, 640, 750, 960],
	priority: true,
});
---

<section class="hero">
	<picture>
		<source media="(min-width: 768px)" srcset={pcImage.srcSet.attribute || pcImage.src} sizes="100vw" type="image/webp" />
		<img
			src={mobileImage.src}
			srcset={mobileImage.srcSet.attribute}
			sizes="100vw"
			alt={heroAlt}
			class="hero__bg"
			width={mobileImage.attributes.width}
			height={mobileImage.attributes.height}
			loading="eager"
			decoding="sync"
			fetchpriority="high"
		/>
	</picture>

	<!-- the hero photo/illustration is purely decorative; the real page
	     heading below carries the equivalent message for SEO/a11y -->
	<h1 class="sr-only">今日中に片付けたい方へ｜山形不用品回収サービス</h1>

	<div class="hero__content l-container">
		<div class="hero__price">
			<span class="hero__price-badge">最短30分</span>
			<span class="hero__price-amount">9,000円〜</span>
		</div>
	</div>
</section>

<div class="hero__badges-wrap l-container">
	<ul class="hero__badges">
		<li class="hero__badge">
			<span class="hero__badge-small">グループ累計</span>
			<span class="hero__badge-big">18万件<span class="hero__badge-mid">以上</span></span>
			<span class="hero__badge-small">作業依頼あり</span>
		</li>
		<li class="hero__badge">
			<span class="hero__badge-small">他社より</span>
			<span class="hero__badge-big">1円<span class="hero__badge-mid">でも</span></span>
			<span class="hero__badge-small">高ければご相談を</span>
		</li>
		<li class="hero__badge">
			<span class="hero__badge-small">お見積もり</span>
			<span class="hero__badge-big">完全無料</span>
			<span class="hero__badge-small">お気軽にどうぞ</span>
		</li>
	</ul>
</div>

<style>
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	/* the image sits in normal document flow and scales at width:100% /
	   height:auto — its own intrinsic aspect ratio is the ONLY thing that
	   determines .hero's height. Overlay content below is positioned
	   against that same box, so there is no second, independently
	   computed size (e.g. a container aspect-ratio + object-fit: cover)
	   that could round differently and drift out of sync at odd zoom
	   levels. */
	.hero {
		position: relative;
		width: 100%;
	}

	.hero__bg {
		display: block;
		width: 100%;
		height: auto;
	}

	/* ---- price badge (overlaid on the hero visual's bottom edge) ---- */

	.hero__content {
		position: absolute;
		inset-inline: 0;
		bottom: 48px;
		text-align: center;
	}

	.hero__price {
		display: inline-flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 4px 14px;
		background: #fff;
		color: var(--color-text);
		border-radius: 4px;
		padding: 10px 22px;
		box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
	}

	.hero__price-badge {
		font-size: 10px;
		line-height: 1.4;
		text-align: center;
	}

	.hero__price-amount {
		font-family: var(--font-number);
		font-weight: 700;
		font-size: 22px;
		line-height: 1;
		color: var(--color-accent-red);
	}

	.hero__badges-wrap {
		position: relative;
		margin-top: -44px;
		padding-bottom: 32px;
	}

	.hero__badges {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 8px;
		max-width: 720px;
		margin-inline: auto;
	}

	.hero__badge {
		background: #fff;
		color: var(--color-text);
		border-radius: 4px;
		padding: 10px 5px;
		display: flex;
		flex-direction: column;
		align-items: center;
		box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
	}

	.hero__badge-small {
		font-size: 10px;
		line-height: 1.4;
		text-align: center;
	}

	.hero__badge-big {
		color: var(--color-accent-red);
		font-size: 15px;
		font-weight: 700;
		line-height: 1.4;
	}

	.hero__badge-mid {
		font-size: 10px;
	}

	@media (min-width: 640px) {
		.hero__badges {
			gap: 12px;
			max-width: none;
		}

		.hero__badge {
			padding: 14px 12px;
		}

		.hero__badge-small {
			font-size: 14px;
		}

		.hero__badge-big {
			font-size: 22px;
		}

		.hero__badge-mid {
			font-size: 16px;
		}

		.hero__price {
			padding: 14px 28px;
		}

		.hero__price-badge {
			font-size: 14px;
		}

		.hero__price-amount {
			font-size: 32px;
		}
	}

	@media (min-width: 768px) {
		.hero__content {
			bottom: 85px;
		}

		.hero__badges-wrap {
			margin-top: -65px;
			padding-bottom: 40px;
		}
	}
</style>
