---
import { Image } from "astro:assets";
import yamagataKaishaGazou from "../../assets/lp/yamagata-kaisha-gazou.webp";
import komattahitoImg from "../../assets/lp/komattahito.png";
import yamagataKeshiki from "../../assets/lp/yamagata-keshiki.webp";
---

<section id="about" class="about">
	<Image src={yamagataKeshiki} alt="" class="about__bg" widths={[640, 1024, 1600, 2000]} sizes="100vw" />
	<div class="about__overlay"></div>
	<div class="l-container">
		<div class="section-heading">
			<p class="section-heading__kicker">山形県の対応実績No.1に挑戦中!</p>
			<p class="section-heading__ja"><span class="section-heading__ja-accent">不用品</span>に困ったら<br />山形不用品回収サービス!</p>
		</div>

		<p class="about__catch"><span class="about__catch-marker">安いだけじゃない、真心込めた丁寧・スピーディな対応!</span></p>

		<div class="about__photo">
			<Image src={yamagataKaishaGazou} alt="山形不用品回収サービスの対応実績" width={1280} height={720} />
		</div>

		<div class="about__panel">
			<p class="about__text"><strong>「誰に頼めばいいか分からない」「対応してもらえるか不安」</strong></p>

			<p class="about__text">
				そんな山形県内のお困りごとに、私たちがすぐに駆けつけます。引越し・実家の片付け・空き家整理・オフィス撤去まで、山形県内No.1の親切対応を目指し、一件一件丁寧に向き合っています。
			</p>

			<div class="about__worries">
				<p class="about__worries-title">
					<span class="about__worries-marker">こんなお悩みありませんか?</span>
				</p>
				<div class="about__worries-layout">
					<p class="about__worry-bubble about__worry-bubble--1">
						<strong class="about__worry-accent">大きい家具・家電</strong>が自分では運び出せない
					</p>
					<p class="about__worry-bubble about__worry-bubble--2">
						<strong class="about__worry-accent">引っ越しまで</strong>に不用品を処分しきれない
					</p>
					<div class="about__worries-figure">
						<Image src={komattahitoImg} alt="" width={612} height={408} />
					</div>
					<p class="about__worry-bubble about__worry-bubble--3">
						<strong class="about__worry-accent">実家の片付け</strong>をどこから始めればいいか分からない
					</p>
					<p class="about__worry-bubble about__worry-bubble--4">
						<strong class="about__worry-accent">空き家</strong>をどうにかしたいが手が回らない
					</p>
				</div>
			</div>

			<p class="about__text">
				こうしたお悩みも、しっかりとヒアリングし、<span class="about__text-marker">社内研修と経験を積んだ熟練スタッフが対応</span>。数多くの現場で培ったチームワークで、迅速・丁寧に解決いたします。
			</p>
		</div>
	</div>
</section>

<style>
	.about {
		position: relative;
		z-index: 0;
		background: var(--color-bg-pale-2);
		padding-block: 60px 90px;
		overflow: hidden;
	}

	.about__bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: -2;
	}

	.about__overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0.42) 50%, rgba(255, 255, 255, 0.5));
		z-index: -1;
	}

	.about .section-heading__ja {
		text-shadow: 0 1px 3px rgba(255, 255, 255, 0.9), 0 2px 16px rgba(255, 255, 255, 0.8), 0 0 4px rgba(255, 255, 255, 0.9);
	}

	.about__catch {
		max-width: 700px;
		margin: 0 auto 24px;
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 16px;
		line-height: 1.7;
		text-align: center;
		color: var(--color-primary-dark);
	}

	.about__catch-marker {
		background: linear-gradient(180deg, transparent 60%, #ffe066 60%);
	}

	.about__photo {
		max-width: 700px;
		margin: 0 auto 24px;
		border-radius: 8px;
		overflow: hidden;
	}

	.about__photo :global(img) {
		width: 100%;
		height: auto;
		display: block;
	}

	.about__panel {
		max-width: 820px;
		margin: 0 auto;
		background: rgba(255, 255, 255, 0.85);
		border-radius: 16px;
		padding: 24px 20px;
	}

	.about__panel > :last-child {
		margin-bottom: 0;
	}

	.about__text {
		max-width: 700px;
		margin: 0 auto 24px;
		font-size: 14px;
		line-height: 1.9;
		color: var(--color-text);
	}

	.about__text-marker {
		background: linear-gradient(180deg, transparent 60%, #ffe066 60%);
	}

	.about__worries {
		max-width: 900px;
		margin: 0 auto 24px;
	}

	.about__worries-title {
		margin: 0 0 20px;
		font-family: var(--font-heading);
		font-weight: 900;
		font-size: 17px;
		text-align: center;
		color: var(--color-text);
	}

	.about__worries-marker {
		background: linear-gradient(180deg, transparent 60%, #ffe066 60%);
	}

	/* mobile: bubbles overlap the corners of the photo instead of stacking
	   above/below it, so the layout is a relative box the bubbles are
	   absolutely positioned within, sized around the centered figure */
	.about__worries-layout {
		position: relative;
		max-width: 300px;
		margin: 0 auto;
		padding-block: 46px 54px;
	}

	.about__worries-figure {
		width: 60%;
		margin-inline: auto;
		position: relative;
		z-index: 1;
	}

	.about__worries-figure :global(img) {
		width: 100%;
		height: auto;
		display: block;
	}

	.about__worry-bubble {
		position: absolute;
		z-index: 2;
		width: 44%;
		margin: 0;
		background: #fff;
		border: 2px solid var(--color-primary);
		border-radius: 12px;
		padding: 8px 10px;
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 10.5px;
		line-height: 1.4;
		text-align: center;
		color: var(--color-text);
		box-shadow: 2px 2px 6px rgba(0, 0, 0, 0.15);
	}

	.about__worry-accent {
		color: var(--color-accent-red);
	}

	.about__worry-bubble--1 {
		top: 14px;
		left: 0;
	}

	.about__worry-bubble--2 {
		bottom: 20px;
		left: 0;
	}

	.about__worry-bubble--3 {
		top: 2px;
		right: 0;
	}

	.about__worry-bubble--4 {
		bottom: 30px;
		right: 0;
	}

	@media (min-width: 768px) {
		.about__catch {
			font-size: 20px;
		}

		.about__photo {
			max-width: 780px;
		}

		.about__panel {
			max-width: 960px;
			padding: 48px 56px;
		}

		.about__text {
			font-size: 16px;
			max-width: 780px;
		}

		.about__worries {
			max-width: 900px;
		}

		.about__worries-title {
			font-size: 22px;
			margin-bottom: 28px;
		}

		.about__worries-layout {
			display: grid;
			grid-template-columns: 1fr minmax(240px, 320px) 1fr;
			grid-template-areas:
				"b1 img b3"
				"b2 img b4";
			align-items: center;
			gap: 24px 32px;
			max-width: none;
			margin: 0;
			padding-block: 0;
		}

		.about__worries-figure {
			grid-area: img;
			width: auto;
			max-width: 320px;
		}

		.about__worry-bubble {
			position: static;
			z-index: auto;
			width: auto;
			font-size: 15px;
			padding: 18px 20px;
			border-radius: 16px;
		}

		.about__worry-bubble--1 {
			grid-area: b1;
			top: auto;
			left: auto;
		}

		.about__worry-bubble--2 {
			grid-area: b2;
			bottom: auto;
			left: auto;
		}

		.about__worry-bubble--3 {
			grid-area: b3;
			top: auto;
			right: auto;
		}

		.about__worry-bubble--4 {
			grid-area: b4;
			bottom: auto;
			right: auto;
		}
	}
</style>
