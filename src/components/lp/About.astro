---
import { Image } from "astro:assets";
import yamagataMember from "../../assets/lp/yamagata-member.webp";
import yamagataKeshiki from "../../assets/lp/yamagata-keshiki.webp";
---

<section id="about" class="about">
	<Image src={yamagataKeshiki} alt="" class="about__bg" widths={[640, 1024, 1600, 2000]} sizes="100vw" />
	<div class="about__overlay"></div>
	<div class="l-container">
		<div class="section-heading">
			<p class="section-heading__kicker">グループ全体で<span class="about__kicker-accent">18万件以上</span>の作業依頼あり!</p>
			<p class="section-heading__ja">山形不用品回収サービスが<br /><span class="section-heading__ja-accent">選ばれる理由</span></p>
		</div>

		<p class="about__catch"><span class="about__catch-marker">安いだけじゃない、真心込めた丁寧・スピーディな対応!</span></p>

		<div class="about__panel">
			<p class="about__text">
				<span class="about__text-bold">「大量の家財処分に困っている」「今すぐ片付けたい」</span>。そんなお悩みは、山形不用品回収サービスへご相談ください。
			</p>

			<p class="about__text">
				お電話一本で、最短30分でプロのスタッフがご自宅へお伺いします。
			</p>

			<p class="about__text">
				研修を積んだ専属スタッフが、<span class="about__text-marker about__text-bold">業界最安値クラスの料金で迅速・ていねいに作業</span>。山形市内なら出張費0円で、追加料金なしの誠実対応でお引き取りいたします。もちろん、山形県全域の他の市町村にも対応。
			</p>

			<div class="about__member">
				<Image
					src={yamagataMember}
					alt="黒いポロシャツ姿のスタッフ6名がトラックの前で笑顔で並ぶ写真と、各現場の片付け・搬出作業の様子を集めたコラージュ"
					width={1280}
					height={720}
					widths={[640, 960, 1280]}
					sizes="(min-width: 768px) 848px, calc(100vw - 80px)"
					loading="lazy"
				/>
			</div>

			<p class="about__text">
				<span class="about__text-marker about__text-bold">「丁寧な対応」「見積もり通りで安心」「他社で断られた相談も安心して依頼できた」</span>と口コミも多数いただいております。
			</p>

			<p class="about__text">
				グループ全体で<span class="about__text-bold">累計18万件の作業依頼で培ったノウハウ</span>で、家具1点のご依頼からゴミ屋敷・空き家まるごとの片付けまで、迅速にお部屋をスッキリさせます。
			</p>
		</div>
	</div>
</section>

<style>
	.about {
		position: relative;
		z-index: 0;
		background: var(--color-bg-pale-2);
		padding-block: 60px 90px;
		overflow: hidden;
	}

	.about__bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: -2;
	}

	.about__overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0.42) 50%, rgba(255, 255, 255, 0.5));
		z-index: -1;
	}

	.about .section-heading__ja {
		text-shadow: 0 1px 3px rgba(255, 255, 255, 0.9), 0 2px 16px rgba(255, 255, 255, 0.8), 0 0 4px rgba(255, 255, 255, 0.9);
	}

	/* "山形不用品回収サービスが" (12 chars) is wider than the old first line, and
	   the global 28px floor would wrap it on narrow phones. Scale the size down
	   with the viewport on mobile only; at 767px and up it is the same 28px
	   (and PC keeps the global clamp). */
	@media (max-width: 767px) {
		.about .section-heading__ja {
			font-size: clamp(20px, 6.9vw, 28px);
		}
	}

	.about__catch {
		max-width: 700px;
		margin: 0 auto 24px;
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 16px;
		line-height: 1.7;
		text-align: center;
		color: var(--color-primary-dark);
	}

	.about__catch-marker {
		background: linear-gradient(180deg, transparent 60%, #ffe066 60%);
	}

	.about__photo {
		max-width: 700px;
		margin: 0 auto 24px;
		border-radius: 8px;
		overflow: hidden;
	}

	.about__photo :global(img) {
		width: 100%;
		height: auto;
		display: block;
	}

	.about__panel {
		max-width: 820px;
		margin: 0 auto;
		background: rgba(255, 255, 255, 0.85);
		border-radius: 16px;
		padding: 24px 20px;
	}

	.about__panel > :last-child {
		margin-bottom: 0;
	}

	.about__text {
		max-width: 700px;
		margin: 0 auto 24px;
		font-size: 14px;
		line-height: 1.9;
		color: var(--color-text);
	}

	/* team photo between two paragraphs: full inner width of the panel, same
	   8px corner radius as the site's other photos, and the same 24px
	   spacing below as a paragraph so the rhythm of the text is kept */
	.about__member {
		margin: 0 0 24px;
		border-radius: 8px;
		overflow: hidden;
	}

	.about__member :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}

	.about__text-marker {
		background: linear-gradient(180deg, transparent 60%, #ffe066 60%);
		/* repeat the highlight on every line when the text wraps */
		-webkit-box-decoration-break: clone;
		box-decoration-break: clone;
	}

	.about__text-bold {
		font-weight: 700;
	}

	.about__kicker-accent {
		color: var(--color-accent-red);
	}

	.about__worries {
		max-width: 900px;
		margin: 0 auto 24px;
	}

	.about__worries-title {
		margin: 0 0 20px;
		font-family: var(--font-heading);
		font-weight: 900;
		font-size: 17px;
		text-align: center;
		color: var(--color-text);
	}

	.about__worries-marker {
		background: linear-gradient(180deg, transparent 60%, #ffe066 60%);
	}

	/* the four worry bubbles sit in a 2 x 2 grid (two per row) */
	.about__worries-layout {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 12px;
	}

	.about__worry-bubble {
		margin: 0;
		background: #fff;
		border: 2px solid var(--color-primary);
		border-radius: 12px;
		padding: 8px 10px;
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 10.5px;
		line-height: 1.4;
		text-align: center;
		color: var(--color-text);
		box-shadow: 2px 2px 6px rgba(0, 0, 0, 0.15);
		/* centre the text vertically so bubbles in the same row look even */
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.about__worry-accent {
		color: var(--color-accent-red);
	}

	.about__arrow {
		margin: -4px 0 20px;
		font-size: 28px;
		line-height: 1;
		text-align: center;
		color: var(--color-primary);
	}

	@media (min-width: 768px) {
		.about__catch {
			font-size: 20px;
		}

		.about__photo {
			max-width: 780px;
		}

		.about__panel {
			max-width: 960px;
			padding: 48px 56px;
		}

		.about__text {
			font-size: 16px;
			max-width: 780px;
		}

		.about__worries {
			max-width: 900px;
		}

		.about__worries-title {
			font-size: 22px;
			margin-bottom: 28px;
		}

		.about__worries-layout {
			gap: 24px 32px;
			max-width: 720px;
			margin: 0 auto;
		}

		.about__worry-bubble {
			font-size: 15px;
			padding: 18px 20px;
			border-radius: 16px;
		}

		.about__arrow {
			margin-bottom: 24px;
			font-size: 36px;
		}
	}
</style>
