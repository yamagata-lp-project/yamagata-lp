---
import case1 from "../../assets/lp/case1.webp";
import case2 from "../../assets/lp/case2.webp";
import case3 from "../../assets/lp/case3.webp";
import case4 from "../../assets/lp/case4.webp";
import case5 from "../../assets/lp/case5.webp";
import case6 from "../../assets/lp/case6.webp";
import tuika1 from "../../assets/lp/tuika-jirei①.webp";
import tuika2 from "../../assets/lp/tuika-jirei②.webp";
import tuika3 from "../../assets/lp/tuika-jirei③.webp";
import tuika4 from "../../assets/lp/tuika-jirei④.webp";
import { Image } from "astro:assets";

// order: the two 引越しに伴う回収作業 cases come first; cases with similar titles (…／…②) sit next to each other
const cases = [
	{
		title: "引越しに伴う回収作業①",
		plan: "軽トラ",
		items: "冷蔵庫・洗濯機、モニター、電子レンジ",
		duration: "15分",
		cost: "15,000円",
		comment: "搬出経路を事前にしっかり確認し、お部屋を傷つけないよう慎重に運び出しました。",
		photo: case2,
	},
	{
		title: "引越しに伴う回収作業②",
		plan: "軽トラ",
		items: "冷蔵庫、洗濯機、自転車、ラック、布団類など",
		duration: "1時間半",
		cost: "27,000円",
		comment: "大型家電から日用品まで幅広い品目でしたが、搬出動線を工夫しながらスムーズに運び出し、予定時間内に作業を完了いたしました。",
		photo: tuika4,
	},
	{
		title: "即日対応のご相談",
		plan: "軽トラ",
		items: "ベッドフレーム、ソファなど",
		duration: "15分",
		cost: "9,000円",
		comment: "急なご依頼でしたが、丁寧に状況を確認しながら手早く対応させていただきました。",
		photo: case1,
	},
	{
		title: "即日対応のご相談②",
		plan: "軽トラ",
		items: "ベッドフレーム(解体含む)、こたつテーブルなど",
		duration: "30分",
		cost: "16,000円",
		comment: "ご連絡をいただいてからすぐにお伺いし、その場で搬出まで対応いたしました。解体が必要なベッドフレームも手早く分解し、短時間で終えることができました。",
		photo: tuika1,
	},
	{
		title: "日常のお片付けでのご利用",
		plan: "軽トラ",
		items: "人形・収納など",
		duration: "20分",
		cost: "9,000円",
		comment: "細かなお荷物も一つひとつ丁寧に扱い、気持ちよくお片付けいただけるよう対応しました。",
		photo: case3,
	},
	{
		title: "日常のお片付けでのご利用②",
		plan: "軽トラ",
		items: "ダイニングセット、棚、ソファなど",
		duration: "1時間",
		cost: "15,000円",
		comment: "大きな家具が複数ございましたが、搬出経路を確認しながら手際よく運び出しました。お部屋もすっきりと片付き、お客様にも喜んでいただけました。",
		photo: tuika2,
	},
	{
		title: "実家の家財整理でのご依頼",
		plan: "軽トラ",
		items: "布団類、棚類、雑貨類",
		duration: "1時間",
		cost: "19,000円",
		comment: "思い出の品も多かったため、お客様のご希望を伺いながら丁寧に仕分けを行いました。",
		photo: case4,
	},
	{
		title: "実家の家財整理でのご依頼②",
		plan: "軽トラ",
		items: "ゴルフセット、衣装ケース、オーディオ機器、段ボールなど",
		duration: "30分",
		cost: "17,000円",
		comment: "趣味の品や思い出の品が多く含まれていたため、お客様のご意向を伺いながら一つひとつ丁寧に確認して作業を進めました。",
		photo: tuika3,
	},
	{
		title: "ご実家の大型家財撤去",
		plan: "1.5t",
		items: "大型タンス・本棚など",
		duration: "2時間",
		cost: "50,000円",
		comment: "大型家具の搬出も複数名で連携し、壁や床を傷つけないよう安全第一で作業しました。",
		photo: case5,
	},
	{
		title: "一軒家丸ごとお片付け",
		plan: "2t",
		items: "お部屋にあるすべてのお荷物",
		duration: "1日",
		cost: "130,000円",
		comment: "一日がかりの作業でしたが、チーム一丸となって最後まで丁寧に対応いたしました。",
		photo: case6,
	},
];
---

<section id="case" class="case">
	<div class="l-container">
		<div class="section-heading">
			<p class="section-heading__kicker">グループ合計18万件以上</p>
			<p class="section-heading__ja" style="color:#0060a6;">作業事例</p>
			<p class="section-heading__lead">グループ全体で積み重ねてきた作業実績の一部をご紹介します。</p>
		</div>

		<div class="case__slider" data-case-slider>
			<ul class="case__list" data-case-track>
				{
					cases.map((c) => (
						<li class="case__card">
							<h3 class="case__title">
								<span>{c.title}</span>
							</h3>
							<div class="case__body">
								<div class="case__photo">
									{c.photo ? (
										<Image src={c.photo} alt={c.title ? `${c.title}の作業事例写真` : "作業事例のビフォーアフター写真"} width={600} height={338} />
									) : (
										<div class="case__photo-empty" aria-hidden="true">
											<span>BEFORE</span>
											<span>AFTER</span>
										</div>
									)}
								</div>
								<dl class="case__desc">
									<div class="case__row">
										<dt>プラン</dt>
										<dd>{c.plan}</dd>
									</div>
									<div class="case__row">
										<dt>お荷物</dt>
										<dd>{c.items}</dd>
									</div>
									<div class="case__row">
										<dt>作業時間</dt>
										<dd>{c.duration}</dd>
									</div>
									<div class="case__row">
										<dt>作業費用</dt>
										<dd class="case__cost">{c.cost}</dd>
									</div>
								</dl>
								<div class="case__comment">
									<p class="case__comment-label">作業員のコメント</p>
									<p class="case__comment-text">{c.comment}</p>
								</div>
							</div>
						</li>
					))
				}
			</ul>

			<div class="case__nav">
				<button type="button" class="case__nav-btn" data-case-prev aria-label="前の事例">
					‹
				</button>
				<button type="button" class="case__nav-btn" data-case-next aria-label="次の事例">
					›
				</button>
			</div>
		</div>
	</div>
</section>

<script>
	document.querySelectorAll<HTMLElement>("[data-case-slider]").forEach((slider) => {
		const track = slider.querySelector<HTMLElement>("[data-case-track]");
		if (!track) return;

		const scrollByOne = (dir: number) => {
			track.scrollBy({ left: dir * track.clientWidth, behavior: "smooth" });
		};

		slider.querySelector("[data-case-prev]")?.addEventListener("click", () => scrollByOne(-1));
		slider.querySelector("[data-case-next]")?.addEventListener("click", () => scrollByOne(1));
	});
</script>

<style>
	.case {
		background: var(--color-bg-pale-3);
		padding-block: 60px 90px;
	}

	.case__slider {
		max-width: 600px;
		margin-inline: auto;
	}

	.case__list {
		display: flex;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		-webkit-overflow-scrolling: touch;
		scrollbar-width: none;
		margin: 0;
		padding: 0;
		border-radius: 6px;
		box-shadow: 2px 2px 8px rgba(0, 0, 0, 0.15);
	}

	.case__list::-webkit-scrollbar {
		display: none;
	}

	.case__card {
		flex: 0 0 100%;
		scroll-snap-align: start;
		background: #fff;
		overflow: hidden;
		display: flex;
		flex-direction: column;
	}

	.case__title {
		background: var(--color-primary);
		color: #fff;
		text-align: center;
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 16px;
		letter-spacing: 0.03em;
		line-height: 1.4;
		margin: 0;
		height: 76px;
		padding-inline: 20px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.case__title span {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.case__body {
		padding: 20px;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.case__photo {
		width: 100%;
		aspect-ratio: 16 / 9;
		background: #eef1f5;
		border-radius: 6px;
		overflow: hidden;
	}

	.case__photo :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	/* placeholder frame for cards that have no before/after photo yet */
	.case__photo-empty {
		width: 100%;
		height: 100%;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2px;
	}

	.case__photo-empty span {
		display: flex;
		align-items: center;
		justify-content: center;
		background: #e3e8ef;
		color: #9aa7b8;
		font-family: var(--font-en);
		font-size: 14px;
		letter-spacing: 0.12em;
	}

	.case__desc {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.case__row {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 8px;
	}

	.case__row dt {
		background: var(--color-bg-pale-2);
		color: var(--color-primary-dark);
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 13px;
		padding: 5px 12px;
		border-radius: 2px;
		white-space: nowrap;
		flex-shrink: 0;
	}

	.case__row dd {
		margin: 0;
		font-size: 14px;
		line-height: 1.7;
		flex: 1;
		min-width: 60px;
		min-height: 1.6em;
		border-bottom: 1px dashed #d9d9d9;
	}

	.case__row dd.case__cost {
		font-weight: 700;
		font-size: 17px;
		color: var(--color-accent-red);
	}

	.case__comment {
		background: var(--color-bg-pale-1);
		border-left: 3px solid var(--color-primary);
		border-radius: 4px;
		padding: 12px 14px;
	}

	.case__comment-label {
		margin: 0 0 4px;
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 12px;
		color: var(--color-primary-dark);
	}

	.case__comment-text {
		margin: 0;
		min-height: 3.4em; /* keeps empty cards as tall as filled ones */
		font-size: 13px;
		line-height: 1.7;
		color: var(--color-text);
	}


	.case__nav {
		margin-top: 20px;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 20px;
	}

	.case__nav-btn {
		width: 44px;
		height: 44px;
		border-radius: 50%;
		border: none;
		background: var(--color-primary);
		color: #fff;
		font-size: 22px;
		line-height: 1;
		cursor: pointer;
		box-shadow: 0 0 8px rgba(0, 0, 0, 0.2);
	}
</style>
