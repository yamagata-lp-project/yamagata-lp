---

<section id="faq" class="faq">
	<div class="l-container">
		<div class="section-heading">
			<p class="section-heading__kicker">気になることはこちら</p>
			<p class="section-heading__ja" style="color:#222;">よくあるご質問</p>
			<p class="section-heading__lead">よくお客様からいただくご質問をまとめました。他に気になる点があれば、遠慮なくお問い合わせください。</p>
		</div>

		<div class="faq__tabs" role="tablist">
			{
				categories.map((cat, i) => (
					<button
						type="button"
						class="faq__tab"
						data-category={cat.id}
						aria-selected={i === 0 ? "true" : "false"}
						style={`--cat-color: ${cat.color}`}
					>
						{cat.label}
					</button>
				))
			}
		</div>

		{
			categories.map((cat, i) => (
				<div
					class="faq__list"
					data-category-panel={cat.id}
					hidden={i === 0 ? undefined : true}
					style={`--cat-color: ${cat.color}`}
				>
					{cat.faqs.map((item) => (
						<details class="faq__item">
							<summary class="faq__summary">
								<span class="faq__q">Q.</span>
								<span class="faq__question">{item.q}</span>
							</summary>
							<p class="faq__answer">{item.a}</p>
						</details>
					))}
				</div>
			))
		}
	</div>
</section>

<script>
	const tabs = document.querySelectorAll<HTMLButtonElement>(".faq__tab");
	const panels = document.querySelectorAll<HTMLElement>("[data-category-panel]");

	tabs.forEach((tab) => {
		tab.addEventListener("click", () => {
			const target = tab.dataset.category;

			tabs.forEach((t) => t.setAttribute("aria-selected", t === tab ? "true" : "false"));
			panels.forEach((panel) => {
				panel.hidden = panel.dataset.categoryPanel !== target;
			});
		});
	});
</script>

<style>
	.faq {
		background: #fff;
		padding-block: 60px 90px;
	}

	.faq__tabs {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 8px;
		max-width: 900px;
		margin: 0 auto 32px;
	}

	.faq__tab {
		flex: 0 1 calc(50% - 4px);
		min-width: 0;
		font-family: var(--font-heading);
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.02em;
		line-height: 1.3;
		white-space: pre-line;
		text-align: center;
		color: var(--color-text);
		background: var(--color-bg-gray);
		border: 1px solid transparent;
		border-radius: 999px;
		padding: 8px 6px;
		cursor: pointer;
		transition:
			background 0.2s,
			color 0.2s,
			border-color 0.2s;
	}

	.faq__tab:hover {
		border-color: var(--cat-color, var(--color-primary));
	}

	.faq__tab[aria-selected="true"] {
		background: var(--cat-color, var(--color-primary));
		border-color: var(--cat-color, var(--color-primary));
		color: #fff;
		font-weight: 700;
	}

	.faq__list {
		display: flex;
		flex-direction: column;
		gap: 16px;
		max-width: 900px;
		margin-inline: auto;
	}

	.faq__list[hidden] {
		display: none;
	}

	.faq__item {
		background: var(--color-bg-gray);
		border-radius: 5px;
		padding: 12px 20px;
		border-left: 4px solid transparent;
		transition: border-color 0.2s;
	}

	.faq__item[open] {
		border-left-color: var(--cat-color, var(--color-primary));
	}

	.faq__summary {
		display: flex;
		align-items: baseline;
		gap: 14px;
		cursor: pointer;
		list-style: none;
	}

	.faq__summary::-webkit-details-marker {
		display: none;
	}

	.faq__q {
		font-family: var(--font-en);
		font-weight: 700;
		font-size: 22px;
		color: var(--cat-color, var(--color-primary));
		flex-shrink: 0;
	}

	.faq__question {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 15px;
		letter-spacing: 0.02em;
	}

	.faq__answer {
		margin: 12px 0 0 40px;
		font-size: 15px;
		line-height: 1.9;
		color: var(--color-text);
	}

	@media (min-width: 768px) {
		.faq__tab {
			flex: 0 1 auto;
			font-size: 15px;
			padding: 12px 24px;
			white-space: pre-line;
		}

		.faq__q {
			font-size: 28px;
		}

		.faq__question {
			font-size: 18px;
		}

		.faq__answer {
			font-size: 16px;
		}
	}
</style>
