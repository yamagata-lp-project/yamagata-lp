---
import { Image } from "astro:assets";
import huyohinkaishuPhoto from "../../assets/lp/huyohinkaishu-shasin.webp";
import kaitoriPhoto from "../../assets/lp/kaitori-shasin.webp";
import ihinseiriPhoto from "../../assets/lp/ihinseiri-shasin.webp";
import gomiyashikiPhoto from "../../assets/lp/gomiyashiki-shasin.webp";
import marugotokatadukePhoto from "../../assets/lp/marugotokataduke-shasin.webp";
import tokushuseisoPhoto from "../../assets/lp/tokushuseiso-shasin.webp";

const services = [
	{
		title: "不用品回収",
		photo: huyohinkaishuPhoto,
		desc: "お問い合わせ1つで、処分にお困りの家具・家電・雑貨などを1点から丸ごとまでお引取りします。",
	},
	{
		title: "不用品買取",
		photo: kaitoriPhoto,
		desc: "高年式の家電、ブランド家具、アクセサリーなど幅広い品目を査定・買取します。作業負担額から相殺します。",
	},
	{
		title: "遺品整理・生前整理",
		photo: ihinseiriPhoto,
		desc: "故人様の家財の仕分け・分別・引取・ご供養まで、トータルサポート。元気なうちの身辺整理にも対応します。",
	},
	{
		title: "ゴミ屋敷片付け",
		photo: gomiyashikiPhoto,
		desc: "ゴミで散らかってしまったお部屋を、最大限プライバシーに配慮してスピード解決します。",
	},
	{
		title: "一棟丸ごと片付け",
		photo: marugotokatadukePhoto,
		desc: "一戸建て、賃貸、マンション、オフィスなど丸ごと片付けに対応。その後の不動産売却までサポートします。",
	},
	{
		title: "特殊清掃",
		photo: tokushuseisoPhoto,
		desc: "専門知識を持つ熟練スタッフが、お部屋の消臭剤・除菌・原状回復まで対応。個人・法人問わずご相談を。",
	},
];
---

<section id="services" class="services">
	<div class="l-container">
		<div class="section-heading">
			<p class="section-heading__kicker">充実した対応</p>
			<p class="section-heading__ja">対応サービス一覧</p>
		</div>

		<div class="services__grid">
			{
				services.map((s) => (
					<div class="services__card">
						<h3 class="services__title">{s.title}</h3>
						<div class="services__photo">
							<Image src={s.photo} alt={`${s.title}のイメージ写真`} width={600} height={338} />
						</div>
						<p class="services__desc">{s.desc}</p>
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	.services {
		background: var(--color-bg-gray);
		padding-block: 60px 90px;
	}

	.services__grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 12px;
		max-width: 900px;
		margin-inline: auto;
	}

	.services__card {
		background: #fff;
		border-radius: 8px;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		box-shadow: 2px 2px 8px rgba(0, 0, 0, 0.1);
	}

	.services__title {
		background: var(--color-primary);
		color: #fff;
		text-align: center;
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 13px;
		letter-spacing: 0.02em;
		line-height: 1.4;
		margin: 0;
		min-height: 44px;
		padding: 10px 8px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.services__photo {
		width: 100%;
		aspect-ratio: 16 / 9;
		background: var(--color-bg-pale-2);
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
	}

	.services__photo :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.services__desc {
		margin: 0;
		padding: 12px 10px 16px;
		font-size: 12px;
		line-height: 1.7;
		color: var(--color-text);
		flex: 1;
	}

	@media (min-width: 600px) {
		.services__title {
			font-size: 15px;
		}

		.services__desc {
			font-size: 14px;
			padding: 16px 16px 20px;
		}
	}

	@media (min-width: 900px) {
		.services__grid {
			max-width: 760px;
		}
	}
</style>
