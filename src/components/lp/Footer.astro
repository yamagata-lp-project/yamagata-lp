---
import { navLinks } from "../../data/navLinks";

const TEL = "0120-442-999";
---

<footer class="footer">
	<div class="l-container footer__inner">
		<p class="footer__logo">山形不用品回収サービス</p>
		<nav class="footer__nav" aria-label="サイト内リンク">
			<ul class="footer__nav-list">
				{
					navLinks.map((link) => (
						<li>
							<a href={link.href}>{link.label}</a>
						</li>
					))
				}
			</ul>
		</nav>
		<div class="footer__info">
			<p>〒990-0038</p>
			<p>山形県山形市幸町2-9</p>
			<p><a href={`tel:${TEL.replace(/-/g, "")}`}>{TEL}</a></p>
		</div>
		<p class="footer__copyright">&copy; 山形不用品回収サービス</p>
	</div>
</footer>

<style>
	.footer {
		background: var(--color-bg-pale-3);
		padding-block: 48px 24px;
	}

	.footer__inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 20px;
		text-align: center;
	}

	.footer__logo {
		font-family: var(--font-logo);
		font-size: 22px;
		color: #000;
	}

	.footer__nav-list {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0 12px;
	}

	.footer__nav-list a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 4px 8px;
		font-family: var(--font-heading);
		font-size: 14px;
		font-weight: 700;
		color: var(--color-text);
	}

	.footer__nav-list a:hover {
		color: var(--color-primary);
	}

	.footer__info {
		font-size: 14px;
		line-height: 1.9;
		color: var(--color-text);
	}

	.footer__info a {
		font-weight: 700;
	}

	.footer__copyright {
		font-size: 12px;
		color: var(--color-text-sub);
		margin-top: 12px;
	}
</style>
