---
const TEL = "0120-442-9999";
---

<footer class="footer">
	<div class="l-container footer__inner">
		<p class="footer__logo">山形不用品回収サービス</p>
		<div class="footer__info">
			<p>〒990-0038</p>
			<p>山形県山形市幸町2-9</p>
			<p><a href={`tel:${TEL.replace(/-/g, "")}`}>{TEL}</a></p>
		</div>
		<div class="footer__cta">
			<a href={`tel:${TEL.replace(/-/g, "")}`} class="btn-cta btn-cta--phone">電話でお問い合わせ</a>
			<a href="https://line.me/" class="btn-cta btn-cta--line" target="_blank" rel="noopener">LINEでお問い合わせ</a>
		</div>
		<p class="footer__copyright">&copy; 山形不用品回収サービス</p>
	</div>
</footer>

<style>
	.footer {
		background: var(--color-bg-pale-3);
		padding-block: 48px 24px;
	}

	.footer__inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 20px;
		text-align: center;
	}

	.footer__logo {
		font-family: var(--font-logo);
		font-size: 22px;
		color: #000;
	}

	.footer__info {
		font-size: 14px;
		line-height: 1.9;
		color: var(--color-text);
	}

	.footer__info a {
		font-weight: 700;
	}

	.footer__cta {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 12px;
	}

	.footer__copyright {
		font-size: 12px;
		color: var(--color-text-sub);
		margin-top: 12px;
	}
</style>
