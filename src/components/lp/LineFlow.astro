---
import iconChat from "../../assets/lp/line-icon-chat.svg";
import iconCamera from "../../assets/lp/line-icon-camera.svg";
import iconQuote from "../../assets/lp/line-icon-quote.svg";
import iconSchedule from "../../assets/lp/flow-icon-04.svg";
import { Image } from "astro:assets";

const steps = [
	{ n: "01", label: "LINEお友達登録", icon: iconChat },
	{ n: "02", label: "写真を送る", icon: iconCamera },
	{ n: "03", label: "担当者が確認して\n見積もりを案内", icon: iconQuote },
	{ n: "04", label: "問題なければ\n日程調整", icon: iconSchedule },
];
---

<section class="line-flow">
	<div class="l-container">
		<div class="line-flow__heading">
			<p class="line-flow__eyebrow">LINE</p>
			<h2 class="line-flow__title">LINEでのお問い合わせもスムーズです</h2>
		</div>

		<ol class="line-flow__steps">
			{
				steps.map((step) => (
					<li class="line-flow__step">
						<span class="line-flow__number">{step.n}</span>
						<span class="line-flow__icon">
							<Image src={step.icon} alt="" width={26} height={26} />
						</span>
						<span class="line-flow__label" style="white-space:pre-line;">{step.label}</span>
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	.line-flow {
		background: #f2fbf5;
		padding-block: 40px 56px;
	}

	.line-flow__heading {
		text-align: center;
		margin-bottom: 28px;
	}

	.line-flow__eyebrow {
		font-family: var(--font-en);
		font-weight: 700;
		font-size: 14px;
		letter-spacing: 0.15em;
		color: var(--color-cta-line);
		text-transform: uppercase;
		margin: 0 0 6px;
	}

	.line-flow__title {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: clamp(19px, 3vw, 26px);
		color: #222;
		letter-spacing: 0.03em;
		margin: 0;
	}

	.line-flow__steps {
		display: flex;
		flex-direction: column;
		gap: 10px;
		max-width: 560px;
		margin-inline: auto;
	}

	.line-flow__step {
		background: #ffffff;
		border: 1px solid #dcefe2;
		border-radius: 8px;
		padding: 16px 14px;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		gap: 6px;
		min-height: 150px;
		box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.06);
	}

	.line-flow__number {
		font-family: var(--font-en);
		font-weight: 700;
		font-size: 22px;
		letter-spacing: 0.05em;
		color: var(--color-cta-line);
	}

	.line-flow__icon {
		width: 38px;
		height: 38px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--color-cta-line);
	}

	.line-flow__icon :global(img) {
		width: 20px;
		height: 20px;
		filter: brightness(0) invert(1);
	}

	.line-flow__label {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 13px;
		letter-spacing: 0.02em;
		line-height: 1.5;
		color: #222;
	}

	@media (min-width: 900px) {
		.line-flow__steps {
			flex-direction: row;
			align-items: stretch;
			max-width: none;
			gap: 14px;
		}

		.line-flow__step {
			flex: 1;
		}
	}
</style>
