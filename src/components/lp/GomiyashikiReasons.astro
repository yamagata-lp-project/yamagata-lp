---
// 仮テキスト
const reasons = [
	{ title: "【仮】自社スタッフで直接作業", text: "【仮テキスト】下請けに出さないため、中間マージンがかかりません。" },
	{ title: "【仮】リサイクル・買取で費用を圧縮", text: "【仮テキスト】再利用できる物は買取・再販し、処分費を抑えます。" },
	{ title: "【仮】独自の処分ルート", text: "【仮テキスト】自社ルートでの処分により、コストを下げています。" },
];
---

<section id="g-reasons" class="g-rsn">
	<div class="l-container">
		<div class="section-heading">
			<p class="section-heading__kicker">低価格にはワケがあります</p>
			<p class="section-heading__ja">当店がリーズナブルな理由</p>
			<p class="section-heading__lead">【仮】品質を落とさず、費用をおさえられる理由をご紹介します。</p>
		</div>
		<ul class="g-rsn__list">
			{reasons.map((r, i) => (
				<li class="g-rsn__item">
					<p class="g-rsn__point">POINT {i + 1}</p>
					<p class="g-rsn__title">{r.title}</p>
					<p class="g-rsn__text">{r.text}</p>
				</li>
			))}
		</ul>
	</div>
</section>

<style>
	.g-rsn { padding-block: 56px; }
	.g-rsn__list { list-style: none; padding: 0; margin: 32px 0 0; display: grid; gap: 14px; }
	.g-rsn__item { border-radius: 12px; border: 2px solid var(--color-primary-pale); padding: 20px; background: #fff; }
	.g-rsn__point { color: var(--color-primary); font-weight: 900; font-size: 13px; letter-spacing: 0.1em; }
	.g-rsn__title { font-weight: 700; font-size: 17px; margin-top: 4px; }
	.g-rsn__text { font-size: 14px; line-height: 1.7; margin-top: 8px; }
	@media (min-width: 768px) { .g-rsn__list { grid-template-columns: repeat(3, 1fr); } }
</style>
