---
const categories = [
	{
		id: "g-price",
		label: "料金について",
		color: "#D35400",
		faqs: [
			{ q: "【仮】ゴミ屋敷の片付け費用はどのくらいかかりますか？", a: "【仮テキスト】お部屋の広さ・物量・状況により異なります。現地確認またはLINEのお写真で確定金額をお見積もりします。" },
			{ q: "【仮】見積もり後に追加料金が発生することはありますか？", a: "【仮テキスト】お見積もり時にお伝えした金額から追加で請求することはありません。" },
			{ q: "【仮】クレジットカードは使えますか？", a: "【仮テキスト】クレジットカード・一部コード決済に対応しています。詳細はお問い合わせください。" },
		],
	},
	{
		id: "g-work",
		label: "作業・日程",
		color: "#4A90D9",
		faqs: [
			{ q: "【仮】作業はどのくらいの日数がかかりますか？", a: "【仮テキスト】物量により異なります。1部屋なら最短1日、一軒家の場合は複数日・複数名で対応します。" },
			{ q: "【仮】即日対応は可能ですか？", a: "【仮テキスト】状況により可能です。まずはお電話・LINEでご相談ください。" },
			{ q: "【仮】立ち会いは必要ですか？", a: "【仮テキスト】立ち会いなしでの作業も可能です。ご希望をお伝えください。" },
		],
	},
	{
		id: "g-privacy",
		label: "プライバシー",
		color: "#16A085",
		faqs: [
			{ q: "【仮】近所に知られずに作業してもらえますか？", a: "【仮テキスト】無地の車両を使用するなど、プライバシーに配慮します。" },
			{ q: "【仮】大切な物を誤って処分されませんか？", a: "【仮テキスト】作業前に必要な物・不要な物を確認しながら進め、貴重品・思い出の品は取り分けます。" },
			{ q: "【仮】害虫・悪臭がひどくても対応できますか？", a: "【仮テキスト】対応可能です。消臭・害虫駆除もあわせてご相談いただけます。" },
		],
	},
];
---

<section id="faq" class="faq">
	<div class="l-container">
		<div class="section-heading">
			<p class="section-heading__kicker">不安はここで解決</p>
			<p class="section-heading__ja" style="color:#222;">よくあるご質問</p>
			<p class="section-heading__lead">よくお客様からいただくご質問をまとめました。他に気になる点があれば、遠慮なくお問い合わせください。</p>
		</div>

		<div class="faq__tabs-slider" data-faq-tabs-slider>
			<div class="faq__tabs" role="tablist" data-faq-tabs-track>
				{
					categories.map((cat, i) => (
						<button
							type="button"
							class="faq__tab"
							data-category={cat.id}
							aria-selected={i === 0 ? "true" : "false"}
							style={`--cat-color: ${cat.color}`}
						>
							{cat.label}
						</button>
					))
				}
			</div>
		</div>

		{
			categories.map((cat, i) => (
				<div
					class="faq__list"
					data-category-panel={cat.id}
					hidden={i === 0 ? undefined : true}
					style={`--cat-color: ${cat.color}`}
				>
					{cat.faqs.map((item) => (
						<details class="faq__item">
							<summary class="faq__summary">
								<span class="faq__q">Q.</span>
								<span class="faq__question">{item.q}</span>
							</summary>
							<p class="faq__answer">{item.a}</p>
						</details>
					))}
				</div>
			))
		}
	</div>
</section>

<script>
	const tabs = document.querySelectorAll<HTMLButtonElement>(".faq__tab");
	const panels = document.querySelectorAll<HTMLElement>("[data-category-panel]");

	tabs.forEach((tab) => {
		tab.addEventListener("click", () => {
			const target = tab.dataset.category;

			tabs.forEach((t) => t.setAttribute("aria-selected", t === tab ? "true" : "false"));
			panels.forEach((panel) => {
				panel.hidden = panel.dataset.categoryPanel !== target;
			});
		});
	});
</script>

<style>
	.faq {
		background: #fff;
		padding-block: 60px 90px;
	}

	.faq__tabs-slider {
		max-width: 900px;
		margin: 0 auto;
	}

	.faq__tabs {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 8px;
		margin: 0 0 32px;
		padding: 4px;
	}

	.faq__tab {
		flex: 0 0 auto;
		min-width: 104px;
		font-family: var(--font-heading);
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.02em;
		line-height: 1.3;
		white-space: pre-line;
		text-align: center;
		color: var(--color-text);
		background: var(--color-bg-gray);
		border: 1px solid transparent;
		border-radius: 999px;
		padding: 10px 16px;
		cursor: pointer;
		transition:
			background 0.2s,
			color 0.2s,
			border-color 0.2s;
	}

	.faq__tab:hover {
		border-color: var(--cat-color, var(--color-primary));
	}

	.faq__tab[aria-selected="true"] {
		background: var(--cat-color, var(--color-primary));
		border-color: var(--cat-color, var(--color-primary));
		color: #fff;
		font-weight: 700;
	}

	.faq__list {
		display: flex;
		flex-direction: column;
		gap: 16px;
		max-width: 900px;
		margin-inline: auto;
	}

	.faq__list[hidden] {
		display: none;
	}

	.faq__item {
		background: var(--color-bg-gray);
		border-radius: 5px;
		padding: 12px 20px;
		border-left: 4px solid transparent;
		transition: border-color 0.2s;
	}

	.faq__item[open] {
		border-left-color: var(--cat-color, var(--color-primary));
	}

	.faq__summary {
		display: flex;
		align-items: baseline;
		gap: 14px;
		cursor: pointer;
		list-style: none;
	}

	.faq__summary::-webkit-details-marker {
		display: none;
	}

	.faq__q {
		font-family: var(--font-en);
		font-weight: 700;
		font-size: 22px;
		color: var(--cat-color, var(--color-primary));
		flex-shrink: 0;
	}

	.faq__question {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 15px;
		letter-spacing: 0.02em;
	}

	.faq__answer {
		margin: 12px 0 0 40px;
		font-size: 15px;
		line-height: 1.9;
		color: var(--color-text);
	}

	@media (min-width: 768px) {
		.faq__tab {
			flex: 0 0 auto;
			min-width: 0;
			font-size: 15px;
			padding: 12px 24px;
			white-space: pre-line;
		}

		.faq__q {
			font-size: 28px;
		}

		.faq__question {
			font-size: 18px;
		}

		.faq__answer {
			font-size: 16px;
		}
	}
</style>
