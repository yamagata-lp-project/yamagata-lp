# Resend (https://resend.com) — used by src/pages/api/estimate.ts to send
# the notification email (to staff) and the auto-reply email (to the customer)
# when the /estimate/ form is submitted.

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Verified sending address/domain in Resend (Domains > Add Domain).
# Used as the "From" address for both the notification and auto-reply emails.
RESEND_FROM_EMAIL="山形不用品回収サービス <no-reply@yourdomain.jp>"

# Where the internal form-submission notification should be sent.
# Comma-separate multiple addresses, e.g. "a@example.com,b@example.com"
RESEND_TO_EMAIL=
